# Pengaturan lingkungan Bakoeria Dive Resort.
# Isi nilainya di hPanel (Websites, Node.js, Environment variables), atau salin
# berkas ini menjadi .env saat mencoba di komputer sendiri.
# Jangan pernah mengunggah .env yang sudah berisi kata sandi ke GitHub.
# Situs tetap bisa dibangun dan dibuka walau semua nilai kosong; tanpa database,
# dashboard dan pemesanan online menampilkan pesan bahwa database belum diatur.

# Database MySQL dari hPanel (Databases, MySQL Databases). Hostinger biasanya
# menambahkan awalan seperti u123456789_ pada nama database dan pengguna.
# Tabel dibuat sendiri pada kunjungan pertama.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Kunci untuk membuat akun developer pertama di /kelola. Hanya dipakai sekali.
PENYIAPAN_KUNCI=

# Alamat lengkap situs, contoh https://bakoeria.com
SITE_URL=

# 64 karakter acak untuk menandatangani sesi masuk. Boleh kosong.
SESSION_SECRET=

# Email pemberitahuan pesanan website lewat email Hostinger (port 465 = SSL).
# Kosongkan bila belum dipakai; pesanan tetap masuk ke dashboard.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=rajaampat@bakoeria.com
SMTP_PASS=
EMAIL_DARI=Bakoeria Dive Resort <rajaampat@bakoeria.com>
