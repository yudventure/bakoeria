# Salin menjadi .env untuk pengembangan lokal. Di produksi, isi satu per satu di
# panel Node.js Hostinger (bagian Environment variables). Lihat DEPLOY.md.

# --- Wajib -------------------------------------------------------------------

# PostgreSQL untuk kalender, pesanan, tamu, pembayaran, dan laporan.
# Pakai alamat "pooled" dari penyedia (Neon, Supabase, atau server sendiri).
DATABASE_URL=postgresql://user:sandi@host:5432/bakoeria

# Kunci untuk membuat akun developer pertama di /kelola. Hanya dipakai sekali.
PENYIAPAN_KUNCI=

# --- Disarankan --------------------------------------------------------------

# Alamat situs, untuk metadata dan pratinjau tautan. Contoh: https://bakoeria.com
SITE_URL=

# Rahasia penanda tangan sesi (string acak minimal 32 karakter). Kosong berarti
# dibuat sekali dan disimpan di folder data.
SESSION_SECRET=

# Folder data untuk akun, pengaturan, isi website, keuangan, SDM, dan gudang.
# Kosong berarti ~/.bakoeria-data (di luar folder aplikasi, aman dari deploy ulang).
BAKOERIA_DATA_DIR=

# --- Opsional ----------------------------------------------------------------

# Email pemberitahuan pesanan website lewat Resend (resend.com). Tanpa ini
# pesanan tetap masuk ke dashboard, hanya emailnya yang tidak terkirim.
RESEND_API_KEY=
EMAIL_DARI=Bakoeria Dive Resort <pesan@domainanda.com>
