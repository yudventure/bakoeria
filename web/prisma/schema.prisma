// Skema database Bakoeria Dive Resort. Satu resort, jadi tidak ada tabel
// properti: semua kamar milik resort yang sama.
//
// Dua aturan yang dibawa dari Unmehopa Management:
//
// 1. Tanggal menginap disimpan sebagai DATE, bukan timestamp. Rentangnya
//    setengah terbuka [check_in, check_out): tamu keluar pada tanggal
//    check-out sehingga kamar bisa dipakai tamu lain hari itu. Sama dengan
//    DTEND di iCal dari OTA.
// 2. Anti-double-booking dijaga database lewat EXCLUDE USING gist pada kolom
//    `stay` (lihat migrasi pertama). Kolom itu GENERATED, tidak pernah ditulis
//    dari aplikasi.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Channel {
  WEBSITE
  WHATSAPP
  BOOKING_COM
  AGODA
  TRAVELOKA
  AIRBNB
  AGEN
  WALK_IN
  BLOCK
}

enum BookingStatus {
  TENTATIVE
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  CONFLICT
  BLOCKED
}

enum BookingSource {
  MANUAL
  ICAL
  WEBSITE
}

enum PaymentKind {
  DEPOSIT
  BALANCE
  EXTRA
  REFUND
}

enum PaymentMethod {
  TRANSFER
  CASH
  EWALLET
  CARD
  OTA_PREPAID
  MIDTRANS
}

enum FeedDirection {
  IMPORT
  EXPORT
}

/// Cottage atau kamar. Tarif dasar per malam dalam rupiah.
model Room {
  id             String  @id @default(cuid())
  name           String  @unique
  roomType       String? @map("room_type")
  capAdult       Int     @default(2) @map("cap_adult")
  capChild       Int     @default(0) @map("cap_child")
  baseRate       Decimal @db.Decimal(14, 2) @map("base_rate")
  isActive       Boolean @default(true) @map("is_active")
  inactiveReason String? @map("inactive_reason")
  sortOrder      Int     @default(0) @map("sort_order")

  bookings      Booking[]
  seasonalRates SeasonalRate[]
  icalFeeds     IcalFeed[]

  @@index([sortOrder])
  @@map("rooms")
}

/// Tarif musiman. Rentang tertutup [date_from, date_to] karena menandai hari
/// kalender. EXCLUDE gist di migrasi mencegah dua tarif menutupi hari sama.
model SeasonalRate {
  id       String   @id @default(cuid())
  roomId   String   @map("room_id")
  dateFrom DateTime @db.Date @map("date_from")
  dateTo   DateTime @db.Date @map("date_to")
  rate     Decimal  @db.Decimal(14, 2)
  label    String?

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, dateFrom])
  @@map("seasonal_rates")
}

model Guest {
  id      String  @id @default(cuid())
  name    String
  phone   String?
  email   String?
  origin  String?
  /// Sertifikasi selam tertinggi, misalnya "Open Water" atau "Advanced".
  diveCert String? @map("dive_cert")
  notes   String?

  bookings Booking[]

  @@index([name])
  @@map("guests")
}

model Booking {
  id      String  @id @default(cuid())
  /// Kode pendek yang diucapkan ke tamu, misalnya BK-7Q4M.
  code    String  @unique
  roomId  String  @map("room_id")
  guestId String? @map("guest_id")

  checkIn  DateTime @db.Date @map("check_in")
  checkOut DateTime @db.Date @map("check_out")

  /// GENERATED ALWAYS AS daterange(check_in, check_out, '[)') STORED.
  stay Unsupported("daterange")?

  channel Channel
  status  BookingStatus @default(TENTATIVE)
  source  BookingSource @default(MANUAL)

  /// UID event iCal. Kunci idempotensi sinkron.
  externalUid String? @map("external_uid")

  /// Jumlah tamu. Null berarti belum diketahui (umum pada impor iCal).
  pax   Int?
  /// Jumlah penyelaman yang dipesan, untuk perencanaan perahu dan pemandu.
  dives Int?

  totalAmount      Decimal? @db.Decimal(14, 2) @map("total_amount")
  otaCommissionEst Decimal? @db.Decimal(14, 2) @map("ota_commission_est")
  notes            String?

  holdExpiresAt DateTime? @map("hold_expires_at")
  conflictGroup String?   @map("conflict_group")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  room     Room      @relation(fields: [roomId], references: [id], onDelete: Restrict)
  guest    Guest?    @relation(fields: [guestId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([roomId, checkIn])
  @@index([status])
  @@index([conflictGroup])
  @@map("bookings")
}

model Payment {
  id         String        @id @default(cuid())
  bookingId  String        @map("booking_id")
  amount     Decimal       @db.Decimal(14, 2)
  kind       PaymentKind
  method     PaymentMethod
  paidAt     DateTime      @db.Date @map("paid_at")
  reference  String?
  recordedBy String?       @map("recorded_by")
  createdAt  DateTime      @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([paidAt])
  @@map("payments")
}

model IcalFeed {
  id            String        @id @default(cuid())
  roomId        String        @map("room_id")
  direction     FeedDirection
  url           String?
  exportToken   String?       @unique @map("export_token")
  otaLabel      String?       @map("ota_label")
  lastSuccessAt DateTime?     @map("last_success_at")
  lastErrorAt   DateTime?     @map("last_error_at")
  lastError     String?       @map("last_error")
  failCount     Int           @default(0) @map("fail_count")
  isActive      Boolean       @default(true) @map("is_active")

  room     Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  syncRuns SyncRun[]

  @@index([roomId])
  @@map("ical_feeds")
}

model SyncRun {
  id             String    @id @default(cuid())
  feedId         String    @map("feed_id")
  startedAt      DateTime  @default(now()) @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  eventsSeen     Int       @default(0) @map("events_seen")
  createdCount   Int       @default(0) @map("created_count")
  updatedCount   Int       @default(0) @map("updated_count")
  cancelledCount Int       @default(0) @map("cancelled_count")
  error          String?

  feed IcalFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@index([feedId, startedAt])
  @@map("sync_runs")
}

/// Siapa mengubah apa. Setiap perubahan booking menulis ke sini.
model AuditLog {
  id       String   @id @default(cuid())
  entity   String
  entityId String   @map("entity_id")
  action   String
  actor    String?
  diffJson Json?    @map("diff_json")
  at       DateTime @default(now())

  @@index([entity, entityId])
  @@index([at])
  @@map("audit_log")
}
