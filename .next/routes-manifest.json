{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/ical/[berkas]",
      "regex": "^/api/ical/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPberkas": "nxtPberkas"
      },
      "namedRegex": "^/api/ical/(?<nxtPberkas>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/modul/[modul]",
      "regex": "^/api/modul/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPmodul": "nxtPmodul"
      },
